// Created World (2042600) is the parent of Asia and the root of the tree.
[
    {
        "name": "created World is the parent of Asia and the root of the tree",
        "request": {
            "endpoint": "search",
            "method": "POST",
            "body": {
                "format": "long",
                "objecttypes": [
