// Created Europe (2044223) is the parent of Germany, attached to the World
// record that already existed from the Hanoi insert.
[
    {
        "name": "created Europe is the parent of Germany, attached to the existing World",
        "request": {
            "endpoint": "search",
            "method": "POST",
            "body": {
                "format": "long",
                "objecttypes": [
                    "place"
                ],
                "search": [
                    {
                        "type": "in",
                        "bool": "must",
                        "fields": [
                            "place.gaz_data.gazId"
                        ],
                        "in": [
                            "2044223"
                        ]
                    }
                ]
            }
        },
        "response": {
            "body": {
                "count": 1,
                "objects": [
                    {
                        "place": {
                            "_id": {{ datastore `germany_parent_id` }},
                            "_id_parent": {{ datastore `world_id` }},
                            "gaz_data": {
                                "gazId": "2044223"
                            }
                        }
                    }
                ]
            }
        }
    }
]
