// Created Vietnam (2281934) is the parent of Hanoi.
[
    {
        "name": "created Vietnam is the parent of Hanoi",
        "request": {
            "endpoint": "search",
            "method": "POST",
            "body": {
                "format": "long",
                "objecttypes": [
                    "place"
                ],
                "search": [
                    {
                        "type": "in",
                        "bool": "must",
                        "fields": [
                            "place.gaz_data.gazId"
                        ],
                        "in": [
                            "2281934"
                        ]
                    }
                ]
            }
        },
        "response": {
            "body": {
                "count": 1,
                "objects": [
                    {
                        "place": {
                            "_id": {{ datastore `hanoi_parent_id` }},
                            "gaz_data": {
                                "gazId": "2281934"
                            }
                        }
                    }
                ]
            }
        },
        "store_response_gjson": {
            "vietnam_parent_id": "body.objects.0.place._id_parent"
        }
    }
]
